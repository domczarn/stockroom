{
  "name": "Booked & Paid Stockroom",
  "short_name": "Stockroom",
  "description": "Track your resale stock, sales and profit.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#131316",
  "theme_color": "#131316",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pip-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Post a parcel",
      "short_name": "Post",
      "description": "Open your parcel QR codes",
      "url": "/?open=dropoff",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add stock",
      "short_name": "Add",
      "url": "/?open=Stock",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "shots",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/*"
          ]
        }
      ]
    }
  }
}